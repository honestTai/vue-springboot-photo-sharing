@startuml
actor "App用户" as user
participant "注册页面" as registerPage
database "数据库" as database
participant "系统" as system
activate user
user -> registerPage: 进入注册页面
activate registerPage

user -> registerPage: 输入姓名、账号、密码，选择头像
registerPage -> system: 用户信息输入
activate system

system -> database: 检验账号唯一性
activate database
database --> system: 账号唯一性校验结果
deactivate database

alt 账号不存在
  system -> database: 存储用户信息
  activate database
  database --> system: 存储结果
  deactivate database
  
  system -> user: 注册成功提示
else 账号已存在
  system --> user: 提示选择其他账号
end
deactivate user
deactivate system
@enduml
